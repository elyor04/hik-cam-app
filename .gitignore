# Wails build output
build/bin

# Frontend (npm/Vite)
node_modules
frontend/dist

# auto-generated Go<->TS bindings, regenerated on every `wails dev`/`wails build`
frontend/wailsjs

# Wails cache file used to detect frontend dependency changes
frontend/package.json.md5

# third_party/go-hikvision-sdk is a real git submodule (see .gitmodules); its own
# .gitignore already excludes internal/sdklib/ (the proprietary binaries/headers,
# populated by its scripts/vendor-sdk.ps1, never committed anywhere). Nothing to
# ignore here for it -- this file only covers this repo's own untracked paths.

# Go build artifacts
*.exe
*.exe~
*.test
*.out

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Env (local secrets/config overrides)
.env
.env.local
